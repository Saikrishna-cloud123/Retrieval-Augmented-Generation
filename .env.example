# RAG Pipeline with Hybrid Search — Environment Variables
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant Configuration (for Milestone 3 — leave defaults for now)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=rag_documents

# Embedding Model (for Milestone 3)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Chunking Configuration (for Milestone 2)
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Retrieval Configuration (for Milestone 5)
TOP_K=5
RRF_K=60

# Logging Level
LOG_LEVEL=INFO
